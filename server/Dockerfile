# ---------------------------------------------
# Python 3.13 공식 이미지 사용 (slim 버전)
# ---------------------------------------------
FROM python:3.13-slim

# ---------------------------------------------
# 1. [추가] 환경 변수 설정 (Python 최적화)
# - PYTHONUNBUFFERED: 로그가 버퍼링 없이 즉시 출력되도록 설정 (도커 로그 확인에 필수)
# - PYTHONDONTWRITEBYTECODE: .pyc 파일 생성 방지 (용량 절약 및 충돌 방지)
# - TZ: 시간대를 서울로 설정 (datetime.now() 사용 시 필수)
# ---------------------------------------------
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Seoul

# ---------------------------------------------
# 2. [추가] OS 시스템 패키지 설치
# - libgomp1: LightGBM 등 ML 라이브러리가 필요로 하는 OpenMP C++ 종속성 (slim에는 빠져있음)
# - tzdata: 시간대(TZ) 설정을 시스템에 적용하기 위해 필요
# ---------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------
# 작업 폴더 생성
# ---------------------------------------------
WORKDIR /app

# ---------------------------------------------
# requirements.txt 복사 및 라이브러리 설치
# ---------------------------------------------
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ---------------------------------------------
# 프로젝트 전체 복사
# ---------------------------------------------
COPY . .

# ---------------------------------------------
# start.sh 파일 권한 부여
# ---------------------------------------------
RUN chmod +x start.sh

# ---------------------------------------------
# 3. [추가] 포트 노출 선언 (문서화 용도)
# - FastAPI가 기본적으로 사용하는 포트를 명시하여 가독성과 호환성 높임
# ---------------------------------------------
EXPOSE 8000

# ---------------------------------------------
# start.sh - 모델 확인/학습 후 FastAPI 실행
# ---------------------------------------------
CMD ["./start.sh"]